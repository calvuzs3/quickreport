<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- "Apri Clienti/Check-up/Interventi su QuickReport" — voice command to jump
         straight to one of the app's three fixed top-level sections.

         actions.intent.OPEN_APP_FEATURE requires the "feature.name" parameter to be
         backed by a closed inventory of known values, declared via the <shortcut>
         elements below (capability-binding + parameter-binding). Free-text/dynamic
         entity search (open a specific client/facility/island by name) was tried
         first but rejected by Play Console: Android's per-app shortcut cap (a
         handful) makes that approach unworkable for an open-ended, changing catalog
         of business records — see project memory for the full story. -->
    <capability android:name="actions.intent.OPEN_APP_FEATURE">
        <intent
            android:targetPackage="net.calvuz.quickreport"
            android:targetClass="net.calvuz.qreport.app.app.presentation.ui.MainActivity">
            <parameter
                android:name="feature.name"
                android:key="feature" />
        </intent>
    </capability>

    <shortcut
        android:shortcutId="section_clients"
        android:enabled="true"
        android:icon="@mipmap/ic_qreport_launcher"
        android:shortcutShortLabel="@string/voice_shortcut_clients_short"
        android:shortcutLongLabel="@string/voice_shortcut_clients_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="net.calvuz.quickreport"
            android:targetClass="net.calvuz.qreport.app.app.presentation.ui.MainActivity"
            android:data="quickreport://clients" />
        <capability-binding android:key="actions.intent.OPEN_APP_FEATURE">
            <parameter-binding
                android:key="feature.name"
                android:value="Clienti" />
        </capability-binding>
    </shortcut>

    <shortcut
        android:shortcutId="section_checkups"
        android:enabled="true"
        android:icon="@mipmap/ic_qreport_launcher"
        android:shortcutShortLabel="@string/voice_shortcut_checkups_short"
        android:shortcutLongLabel="@string/voice_shortcut_checkups_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="net.calvuz.quickreport"
            android:targetClass="net.calvuz.qreport.app.app.presentation.ui.MainActivity"
            android:data="quickreport://checkups" />
        <capability-binding android:key="actions.intent.OPEN_APP_FEATURE">
            <parameter-binding
                android:key="feature.name"
                android:value="Check-up" />
        </capability-binding>
    </shortcut>

    <shortcut
        android:shortcutId="section_interventions"
        android:enabled="true"
        android:icon="@mipmap/ic_qreport_launcher"
        android:shortcutShortLabel="@string/voice_shortcut_interventions_short"
        android:shortcutLongLabel="@string/voice_shortcut_interventions_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="net.calvuz.quickreport"
            android:targetClass="net.calvuz.qreport.app.app.presentation.ui.MainActivity"
            android:data="quickreport://interventions" />
        <capability-binding android:key="actions.intent.OPEN_APP_FEATURE">
            <parameter-binding
                android:key="feature.name"
                android:value="Interventi" />
        </capability-binding>
    </shortcut>

</shortcuts>
